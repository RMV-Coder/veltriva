{
  "name": "veltriva",
  "productName": "Veltriva Browser",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first, Chromium-powered desktop browser that manages inactive tabs and keeps a searchable local tab memory.",
  "author": "Raymond Valdepeñas",
  "license": "MIT",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "setup": "npm ci && node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:dir": "electron-vite build && electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "1.57.0",
    "prettier": "3.9.10",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.21.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
