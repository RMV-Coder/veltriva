{
  // Electron main process: Node and Electron APIs, no DOM.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node", "electron-vite/node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.main.tsbuildinfo"
  },
  "include": ["src/main/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
