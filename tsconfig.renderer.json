{
  // Shell UI (React): DOM only. No Node, no Electron; it talks to main through `window.veltriva`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/renderer/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.renderer.tsbuildinfo"
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
