{
  // Tooling and tests that run on plain Node: config files, unit tests, Playwright specs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": [
    "*.config.ts",
    "*.config.mts",
    "scripts/*.d.mts",
    "scripts/*.test.ts",
    "src/**/*.test.ts",
    "src/data/*.d.ts",
    "src/data/repos/test-database.ts",
    "tests/**/*.ts"
  ]
}
